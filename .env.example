# 預設使用本機 Codex CLI，沿用 codex login 的登入狀態。
MODEL_PROVIDER=codex
# 啟動時準備長駐 CLI；exec 為明確選用的逐次命令模式。
CODEX_TRANSPORT=app-server
PORT=5173
# 僅開發模式使用，瀏覽器仍開啟 PORT 指定的網址。
API_PORT=8787
# 單次模型呼叫的逾時上限（毫秒）；不套用到整個代理執行。
MODEL_TIMEOUT_MS=180000
# 代理（/api/agent）一次執行最多進行的模型回合數。
AGENT_MAX_ROUNDS=6
# 代理一次執行的總時間上限（毫秒）；逾時會結束本次執行，已套用的變更會保留。
AGENT_TOTAL_TIMEOUT_MS=600000
# 留空沿用長駐 CLI 設定預設；可指定目前帳戶可用的模型。
CODEX_MODEL=
# CLI 不在 PATH 時，填入 codex.exe 的絕對路徑。
CODEX_CLI_PATH=

# 選用 Claude Code CLI：將 MODEL_PROVIDER 改成 claude，沿用 claude auth login 的登入狀態。
# 留空預設 claude-sonnet-5-5（Sonnet 5.5）。
CLAUDE_MODEL=
# CLI 不在 PATH 時，填入 claude.exe 的絕對路徑（npm 安裝會自動找 claude.cmd 背後的 claude.exe）。
CLAUDE_CLI_PATH=

# 選用 API：將 MODEL_PROVIDER 改成 openai，再設定服務端金鑰。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
